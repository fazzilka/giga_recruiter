TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TARGET_BOT=Giga_recruiter_bot
# Exact hosts allowed for vacancy text downloads; no redirects or other pages.
VACANCY_HOSTS=rabota.sber.ru
CODEX_BIN=codex
# Leave empty to use the CLI default model.
CODEX_MODEL=
CODEX_TIMEOUT=180
# Prevent an unattended interview from looping forever.
MAX_ANSWERS=30

# Event coalescing and fallback after missed Telegram updates.
MESSAGE_DEBOUNCE=0.6
RECONCILIATION_INTERVAL=30

# Pause before sending an answer (seconds).
SEND_DELAY_SECONDS=30
